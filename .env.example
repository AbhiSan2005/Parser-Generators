# -------------------------------------------------------------
# Docker Compose & Local Environment Configuration
# -------------------------------------------------------------

# MongoDB Connection String (MongoDB Atlas or local)
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/TocProjectDB

# Google Cloud OAuth 2.0 Web Client ID (Free - Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# LLM / AI Integration Keys
GEMINI_API_KEY=your-gemini-api-key
NVIDIA_API_KEY=your-nvidia-api-key

# Optional: Frontend API URL (leave empty when using Docker Nginx reverse proxy)
VITE_API_URL=

